# Phase 0 (観察版) の環境変数。実値は .env に書き、コミットしないこと。
PORT=8080
# 末尾スラッシュなし。デプロイ後のサービス URL
PUBLIC_BASE_URL=https://your-service-xxxx.a.run.app
# HS256 署名鍵 (32バイト以上推奨): openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string
JWT_KEY_ID=v1
# npm run hash-password で生成 (形式: scrypt$<salt_hex>$<hash_hex>)
OWNER_PASSWORD_HASH=
# アクセストークン寿命 (秒)。Phase 0 は 300
ACCESS_TTL=300
REFRESH_IDLE_TTL=7776000
REFRESH_MAX_TTL=31536000
# true でリフレッシュトークンをローテーション
ROTATE_REFRESH=false
# firestore | memory
STORE_BACKEND=memory
# 名前付き DB を使う場合に指定 (例: kuchida-devel)
FIRESTORE_DATABASE_ID=(default)
# ローカル開発のみ true
ALLOW_LOCALHOST_REDIRECT=false
# Notion API (Phase 1 以降)
NOTION_TOKEN=
NOTION_API_VERSION=2025-09-03
READ_ONLY=true
